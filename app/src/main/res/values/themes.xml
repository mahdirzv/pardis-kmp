<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main Pardis theme using design tokens (cream background, etc.).
         NoActionBar: the app is pure Compose; the framework title bar is not part of the design.
         Light status bar (dark icons) over the cream background to match the Rivana design. -->
    <style name="Theme.Pardis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pardis_background</item>
        <item name="android:statusBarColor">@color/pardis_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/pardis_background</item>
    </style>

    <!-- Launch/splash theme for branded start screen -->
    <style name="Theme.Pardis.Launch" parent="Theme.Pardis">
        <item name="android:windowBackground">@color/pardis_background</item>
        <!-- Could use a layer-list drawable for logo later -->
    </style>

    <style name="Theme.Pardis.NoDisplay" parent="android:Theme.NoDisplay">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
