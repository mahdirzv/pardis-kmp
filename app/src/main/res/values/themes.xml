<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main Pardis theme using design tokens (cream background, etc.) -->
    <style name="Theme.Pardis" parent="android:Theme">
        <item name="android:windowBackground">@color/pardis_background</item>
        <item name="android:statusBarColor">@color/pardis_indigo</item>
    </style>

    <!-- Launch/splash theme for branded start screen -->
    <style name="Theme.Pardis.Launch" parent="Theme.Pardis">
        <item name="android:windowBackground">@color/pardis_background</item>
        <!-- Could use a layer-list drawable for logo later -->
    </style>

    <style name="Theme.Pardis.NoDisplay" parent="android:Theme.NoDisplay">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
