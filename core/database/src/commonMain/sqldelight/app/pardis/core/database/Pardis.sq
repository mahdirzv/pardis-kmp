CREATE TABLE cached_story (
    slug TEXT PRIMARY KEY,
    title_en TEXT NOT NULL,
    title_fa TEXT NOT NULL,
    age_band TEXT NOT NULL,
    data_json TEXT NOT NULL,  -- full serialized Story for offline
    downloaded_at INTEGER NOT NULL
);

-- Basic cache ops for stories list (Phase 1 offline)
insertOrReplaceStory:
INSERT OR REPLACE INTO cached_story(slug, title_en, title_fa, age_band, data_json, downloaded_at)
VALUES(?, ?, ?, ?, ?, ?);

selectAllStories:
SELECT slug, title_en, title_fa, age_band, data_json, downloaded_at FROM cached_story ORDER BY title_fa;

selectStory:
SELECT slug, title_en, title_fa, age_band, data_json, downloaded_at FROM cached_story WHERE slug = ?;

-- Simple per-story progress (last page read) for resume
CREATE TABLE story_progress (
    slug TEXT PRIMARY KEY,
    last_page INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL
);

upsertProgress:
INSERT OR REPLACE INTO story_progress(slug, last_page, updated_at)
VALUES(?, ?, ?);

getProgress:
SELECT last_page FROM story_progress WHERE slug = ?;

-- Cached full reader pages JSON (prereq for offline reader + offline video cues/text).
-- Mirrors cached_story pattern. Enables getStoryPages fallback.
CREATE TABLE cached_pages (
    slug TEXT PRIMARY KEY,
    data_json TEXT NOT NULL,  -- serialized List<StoryPage>
    downloaded_at INTEGER NOT NULL
);

insertOrReplacePages:
INSERT OR REPLACE INTO cached_pages(slug, data_json, downloaded_at)
VALUES(?, ?, ?);

selectPages:
SELECT * FROM cached_pages WHERE slug = ?;

-- Generic key-value app settings (e.g. selected_profile_id). Reusable beyond profiles.
CREATE TABLE app_setting (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);

setSetting:
INSERT OR REPLACE INTO app_setting(key, value) VALUES(?, ?);

getSetting:
SELECT value FROM app_setting WHERE key = ?;