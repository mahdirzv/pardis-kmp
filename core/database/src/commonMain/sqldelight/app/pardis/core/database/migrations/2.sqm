-- Migration 2: Add generic app_setting key-value table.
-- Added to Pardis.sq in a later commit without a migration, so databases already at
-- version 2 (post-cached_pages) were missing this table and crashed on getSetting
-- ("no such table: app_setting"). This migration backfills it for existing installs.
CREATE TABLE app_setting (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);
